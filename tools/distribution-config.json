    "excludePatterns": {
        "_comment": "Regex (insensible a la casse) testees sur le chemin relatif dans files/ avec des /",
        "donnees perso joueur": [
            "^fancymenu_data/",
            "^config/jei/world/",
            "^config/litematica/",
            "^config/jade/usernamecache\\.json$",
            "^config/fancymenu/user_variables\\.db$",
            "^config/inventoryprofilesnext/[^/]+&[0-9]+/",
            "^config/sound_physics_remastered/sound_rates\\.properties$"
        ],
        "fichiers temporaires": [
            "\\.bak$",
            "\\.log$",
            "(^|/)logs/",
            "^config/spark/tmp(-client)?/"
        ],
        "SENSIBLE - configs serveur avec identifiants ou donnees": [
            "^config/nerysiaquest/database\\.properties$",
            "^config/nerysiaquest/data\\.db$",
            "^config/nerysia_mod/redis\\.json$"
        ],
        "configs cote serveur uniquement": [
            "-server\\.toml$",
            "^config/cobblenav/server-config\\.json$",
            "^config/polymer/server\\.json$",
            "^config/nerysia_mod/(banned_mods|banned_words|blocked_spawns|clearlag)\\.json$",
            "^config/nerysia_mod/(raids|crates)/",
            "^config/nerysiaquest/"
        ]
    },
